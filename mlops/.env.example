POSTGRES_PASSWORD=replace-with-a-long-random-local-password
AIRFLOW_DB_PASSWORD=replace-with-a-different-long-random-password
MLFLOW_DB_PASSWORD=replace-with-another-long-random-password
AIRFLOW_JWT_SECRET=replace-with-at-least-32-random-bytes
AIRFLOW_FERNET_KEY=replace-with-a-generated-fernet-key
AIRFLOW_DATABASE_URI=postgresql+psycopg2://airflow:password@postgres:5432/airflow
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://mlflow:password@postgres:5432/mlflow
